+                }
+            } else if window == nil {
                 initView(vo, layer)
                 initWindow(vo, previousActiveApp)
                 initWindowState()
             }
 
-            if forcePosition {
+            if embedded != nil {
+                // The host lays out its view.
+            } else if forcePosition {
                 window?.updateFrame(wr, screen)
             } else if option.vo.auto_window_resize {
                 window?.updateSize(wr.size)
@@ -76,12 +86,60 @@ class MacCommon: Common {
         return true
     }
 
+    // Embeds the layer in a view filling the NSView that --wid points to,
+    // the host's: it lays the view out, takes the input and owns the window.
+    func initEmbedded(_ layer: MetalLayer) {
+        let host = Unmanaged<NSView>.fromOpaque(UnsafeRawPointer(bitPattern: Int(option.vo.WinID))!)
+            .takeUnretainedValue()
+        let view = NSView(frame: host.bounds)
+        view.autoresizingMask = [.width, .height]
+        view.layer = layer
+        view.wantsLayer = true
+        view.layerContentsPlacement = .scaleProportionallyToFit
+        view.postsFrameChangedNotifications = true
+        host.addSubview(view)
+        embedded = view
+        layer.contentsScale = host.window?.backingScaleFactor ?? 1
+
+        let center = NotificationCenter.default
+        embeddedObservers = [
+            center.addObserver(forName: NSView.frameDidChangeNotification, object: view, queue: .main) { _ in
+                self.windowDidResize()
+            },
+            center.addObserver(forName: NSWindow.didChangeBackingPropertiesNotification, object: nil,
+                               queue: .main) { n in
+                if (n.object as? NSWindow) == self.embedded?.window { self.windowDidChangeBackingProperties() }
+            },
+            center.addObserver(forName: NSWindow.didChangeScreenNotification, object: nil, queue: .main) { n in
+                if (n.object as? NSWindow) == self.embedded?.window {
+                    self.updateDisplaylink()
+                    self.windowDidChangeScreenProfile()
+                }
+            },
+            center.addObserver(forName: NSWindow.didChangeOcclusionStateNotification, object: nil,
+                               queue: .main) { n in
+                if (n.object as? NSWindow) == self.embedded?.window { self.windowDidChangeOcclusionState() }
+            },
+        ]
+    }
+
+    // The size of the drawable in pixels: the window's, or the embedded
+    // view's.
+    @objc var framePixel: CGSize {
+        if let view = embedded {
+            return view.convertToBacking(view.bounds).size
+        }
+        return window?.framePixel.size ?? .zero
+    }
+
     @objc func uninit(_ vo: UnsafeMutablePointer<vo>) {
         window?.waitForAnimation()
 
         timer?.terminate()
 
         DispatchQueue.main.sync {
+            embeddedObservers.forEach { NotificationCenter.default.removeObserver($0) }
+            embeddedObservers = []
             window?.delegate = nil
             window?.close()
 
@@ -111,6 +169,7 @@ class MacCommon: Common {
 
     @objc func isVisible() -> Bool {
         return window?.occlusionState.contains(.visible) ?? false ||
+               embedded?.window?.occlusionState.contains(.visible) ?? false ||
                option.vo.force_render ||
                needsInitialDraw
     }
@@ -175,7 +234,7 @@ class MacCommon: Common {
     }
 
     override func windowDidChangeBackingProperties() {
-        layer?.contentsScale = window?.backingScaleFactor ?? 1
+        layer?.contentsScale = window?.backingScaleFactor ?? embedded?.window?.backingScaleFactor ?? 1
         windowDidResize()
     }
 
diff --git a/video/out/vulkan/context_mac.m b/video/out/vulkan/context_mac.m
index 559e361..a1cf4d2 100644
--- a/video/out/vulkan/context_mac.m
