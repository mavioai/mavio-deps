         let log = LogHelper(mp_log_new(vo, vo.pointee.log, "mac"))
@@ -45,7 +46,10 @@ class MacCommon: Common {
 
         DispatchQueue.main.sync {
             let previousActiveApp = getActiveApp()
-            initApp()
+            // An embedded mpv leaves the app's policy and icon to the host.
+            if option.vo.WinID <= 0 {
+                initApp()
+            }
 
             let (screen, wr, forcePosition) = getInitProperties(vo)
             guard let layer = self.layer else {
@@ -53,13 +57,19 @@ class MacCommon: Common {
                 exit(1)
             }
 
-            if window == nil {
+            if option.vo.WinID > 0 {
+                if embedded == nil {
