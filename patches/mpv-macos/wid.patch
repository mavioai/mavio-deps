Mavio's patch to embed mpv in a host view: with --wid set to an NSView*
(as an int64), the macvk context (vo=gpu-next, gpu-context=macvk) draws in
a view of its own added to that view, which the host lays out, instead of
creating a window, and leaves the application's activation policy, menu
and icon to the host. Against mpv 88eb9f2; scripts/build-mpv-macos.sh
applies it with git apply, which skips this header.

diff --git a/video/out/mac/common.swift b/video/out/mac/common.swift
index 07b9f83..d604346 100644
--- a/video/out/mac/common.swift
+++ b/video/out/mac/common.swift
@@ -26,6 +26,9 @@ class Common: NSObject {
 
     @objc var window: Window?
     var view: View?
+    // The view mpv draws into in the host's view of --wid, when embedded,
+    // instead of a window of its own.
+    @objc var embedded: NSView?
     var titleBar: TitleBar?
 
     var link: CVDisplayLink?
@@ -155,6 +158,8 @@ class Common: NSObject {
 
         titleBar?.removeFromSuperview()
         view?.removeFromSuperview()
+        embedded?.removeFromSuperview()
+        embedded = nil
     }
 
     func displayLinkCallback(_ displayLink: CVDisplayLink,
@@ -188,7 +193,7 @@ class Common: NSObject {
     }
 
     func updateDisplaylink() {
-        guard let screen = window?.screen, let link = self.link else {
+        guard let screen = window?.screen ?? embedded?.window?.screen, let link = self.link else {
             log.warning("Couldn't update DisplayLink, no Screen or DisplayLink available")
             return
         }
@@ -313,7 +318,7 @@ class Common: NSObject {
     var reconfigureCallback: CGDisplayReconfigurationCallBack = { (display, flags, userInfo) in
         if flags.contains(.setModeFlag) {
             let com = unsafeBitCast(userInfo, to: Common.self)
-            let displayID = com.window?.screen?.displayID ?? display
+            let displayID = (com.window?.screen ?? com.embedded?.window?.screen)?.displayID ?? display
 
             if displayID == display {
                 com.log.verbose("Detected display mode change, updating screen refresh rate")
@@ -404,6 +409,7 @@ class Common: NSObject {
     }
 
     func getCurrentScreen() -> NSScreen? {
+         if let embedded = embedded { return embedded.window?.screen ?? NSScreen.main }
          return window != nil ? window?.screen :
                                     getTargetScreen(forFullscreen: false) ??
                                     NSScreen.main
@@ -564,7 +570,7 @@ class Common: NSObject {
         case VOCTRL_GET_HIDPI_SCALE:
             let scaleFactor = data!.assumingMemoryBound(to: CDouble.self)
             let screen = getCurrentScreen()
-            let factor = window?.backingScaleFactor ??
+            let factor = window?.backingScaleFactor ?? embedded?.window?.backingScaleFactor ??
                          screen?.backingScaleFactor ?? 1.0
             scaleFactor.pointee = Double(factor)
             return VO_TRUE
diff --git a/video/out/mac_common.swift b/video/out/mac_common.swift
index e2e9dd1..45a4f1c 100644
--- a/video/out/mac_common.swift
+++ b/video/out/mac_common.swift
@@ -24,6 +24,7 @@ class MacCommon: Common {
     var timer: PreciseTimer?
