diff --git a/audio/out/ao_coreaudio_chmap.c b/audio/out/ao_coreaudio_chmap.c
index 2c6131f..0204bf1 100644
--- a/audio/out/ao_coreaudio_chmap.c
+++ b/audio/out/ao_coreaudio_chmap.c
@@ -484,6 +484,75 @@ static void ca_retrieve_layouts(struct ao *ao, struct mp_chmap_sel *s,
     talloc_free(ta_ctx);
 }
 
+// The stream's channel playing speaker, or -1.
+static int ca_stream_channel(struct ao *ao, int speaker)
+{
+    for (int n = 0; n < ao->channels.num; n++) {
+        if (ao->channels.speaker[n] == speaker)
+            return n;
+    }
+    return -1;
+}
+
+// Fills map, one entry for each of the device's channels, with the stream's
+// channel it plays (or -1), from the device's preferred layout or, when its
+// channels are not labelled, its stereo pair (as Audio MIDI Setup's speaker
+// configuration sets them). Returns false if they name none of the stream's
+// channels, leaving the unit's own map.
+bool ca_get_channel_map(struct ao *ao, AudioDeviceID device,
+                        int device_channels, SInt32 *map)
+{
+    void *ta_ctx = talloc_new(NULL);
+    bool found = false;
+
+    for (int d = 0; d < device_channels; d++)
+        map[d] = -1;
+
+    AudioChannelLayout *ml = ca_query_layout(ao, device, ta_ctx);
+    AudioChannelLayout *l = ml ? ca_layout_to_custom_layout(ao, ta_ctx, ml) : NULL;
+    for (int d = 0; l && d < device_channels &&
+                    d < l->mNumberChannelDescriptions; d++)
+    {
+        int speaker = ca_label_to_mp_speaker_id(
+            l->mChannelDescriptions[d].mChannelLabel);
+        if (speaker >= 0)
+            map[d] = ca_stream_channel(ao, speaker);
+        found |= map[d] >= 0;
+    }
+
+    int left = ca_stream_channel(ao, MP_SPEAKER_ID_FL);
+    int right = ca_stream_channel(ao, MP_SPEAKER_ID_FR);
+    if (!found && left >= 0 && right >= 0) {
+        uint32_t channels[2];
+        uint32_t psize = sizeof(channels);
+        AudioObjectPropertyAddress p_addr = (AudioObjectPropertyAddress) {
+            .mSelector = kAudioDevicePropertyPreferredChannelsForStereo,
+            .mScope    = kAudioDevicePropertyScopeOutput,
+            .mElement  = kAudioObjectPropertyElementWildcard,
+        };
+        OSStatus err = AudioObjectGetPropertyData(device, &p_addr, 0, NULL,
+                                                  &psize, channels);
+        if (err == noErr && channels[0] != channels[1] &&
+            channels[0] >= 1 && channels[0] <= device_channels &&
+            channels[1] >= 1 && channels[1] <= device_channels)
+        {
+            map[channels[0] - 1] = left;
+            map[channels[1] - 1] = right;
+            found = true;
+        }
+    }
+
+    if (found) {
+        MP_VERBOSE(ao, "channel map:");
+        for (int d = 0; d < device_channels; d++)
+            MP_VERBOSE(ao, " %d", (int) map[d]);
+        MP_VERBOSE(ao, "\n");
+    }
+
+    talloc_free(ta_ctx);
+    return found;
+}
